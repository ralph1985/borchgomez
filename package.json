{
  "name": "borchgomez",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "css:build": "sass --no-source-map src/styles/main.scss public/assets/css/style.css",
    "css:watch": "sass --watch --no-source-map src/styles/main.scss public/assets/css/style.css",
    "lint": "pnpm run lint:astro && pnpm run lint:js && pnpm run lint:scss && pnpm run format:check",
    "lint:astro": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint:js": "eslint \"*.config.js\" \"astro.config.mjs\" \"scripts/**/*.mjs\" \"src/**/*.{astro,js,ts}\" \"studio/**/*.{js,ts}\"",
    "lint:scss": "stylelint \"src/styles/**/*.scss\"",
    "format:check": "prettier --check package.json tsconfig.json eslint.config.js stylelint.config.js prettier.config.js",
    "build": "pnpm run css:build && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "prepare": "husky",
    "sync:fallbacks": "node scripts/sync-sanity-fallbacks.mjs",
    "sync:fallbacks:check": "node scripts/sync-sanity-fallbacks.mjs --check",
    "seed:about": "pnpm --dir studio run seed:about",
    "seed:portfolio": "pnpm --dir studio run seed:portfolio",
    "seed:services": "pnpm --dir studio run seed:services"
  },
  "dependencies": {
    "@sanity/client": "7.23.0",
    "@vercel/analytics": "^2.0.1",
    "animejs": "4.5.0",
    "astro": "7.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@eslint/js": "10.0.1",
    "@types/node": "26.0.1",
    "eslint": "10.6.0",
    "eslint-plugin-astro": "2.1.1",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "prettier": "3.9.4",
    "prettier-plugin-astro": "0.14.1",
    "sass": "1.101.0",
    "stylelint": "17.14.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  }
}
