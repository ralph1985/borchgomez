#!/bin/sh
set -eu

if ! git diff --quiet -- index.html; then
  echo "Hay cambios sin commitear en index.html. Haz commit antes de hacer push." >&2
  exit 1
fi

if ! git diff --cached --quiet -- index.html; then
  echo "Hay cambios staged sin commitear en index.html. Haz commit antes de hacer push." >&2
  exit 1
fi
