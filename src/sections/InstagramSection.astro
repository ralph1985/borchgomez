---
import type { SiteSettings } from "../domain/home-page";
interface Props { instagram: SiteSettings["instagram"]; }
const { instagram } = Astro.props;
---
<section class="instagram section" id="instagram">
  <div class="bd-container">
    <h2 class="section-title" data-animate>{instagram.title}</h2>
    <p class="section-subtitle" data-animate>{instagram.subtitle}</p>
    <div class="portfolio__preview-grid" data-animate>
      {instagram.previews.map((preview) => <a href={preview.href} target="_blank" rel="noopener noreferrer" class="portfolio__preview-item" aria-label={preview.ariaLabel}><img src={preview.image.src} alt={preview.image.alt} width={preview.image.width} height={preview.image.height} loading="lazy" decoding="async" /></a>)}
    </div>
    <div class="portfolio__actions" data-animate><a class="contact__instagram" href={instagram.cta.href} target="_blank" rel="noopener noreferrer">{instagram.cta.label}</a></div>
  </div>
</section>
