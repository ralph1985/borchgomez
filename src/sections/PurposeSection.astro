---
import type { SiteSettings } from "../domain/home-page";
interface Props { purpose: SiteSettings["purpose"]; }
const { purpose } = Astro.props;
const closingParagraphs = purpose.closing.split(/\n{2,}/).map((paragraph) => paragraph.trim()).filter(Boolean);
const closingQuote = closingParagraphs.at(-1) ?? purpose.closing;
const closingBody = closingParagraphs.slice(0, -1);
---
<section class="purpose section" id="purpose">
  <div class="bd-container purpose__container">
    <div class="purpose__header" data-animate>
      <h2 class="section-title">{purpose.title}</h2>
      <p class="section-subtitle">{purpose.subtitle}</p>
    </div>
    <div class="purpose__layout">
      <picture class="purpose__visual" data-animate>
        {purpose.image.srcset && <source srcset={purpose.image.srcset} sizes={purpose.image.sizes} />}
        <img src={purpose.image.src} alt={purpose.image.alt} width={purpose.image.width} height={purpose.image.height} loading="lazy" decoding="async" />
      </picture>
      <div class="purpose__content">
        <p class="purpose__highlight" data-animate>{purpose.highlightedQuote}</p>
        <div class="purpose__grid" data-animate>
          {purpose.items.map((item) => <article class="purpose__item"><h3>{item.title}</h3><p>{item.text}</p></article>)}
        </div>
        <div class="purpose__closing-group" data-animate>
          {closingBody.map((paragraph) => <p class="purpose__closing-text">{paragraph}</p>)}
          <blockquote class="purpose__closing">{closingQuote}</blockquote>
        </div>
      </div>
    </div>
  </div>
</section>
