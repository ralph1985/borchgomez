---
import type { SiteSettings } from "../domain/home-page";
interface Props { purpose: SiteSettings["purpose"]; }
const { purpose } = Astro.props;
---
<section class="purpose section" id="purpose">
  <div class="bd-container purpose__container">
    <h2 class="section-title" data-animate>{purpose.title}</h2>
    <p class="section-subtitle" data-animate>{purpose.subtitle}</p>
    <div class="purpose__grid" data-animate>
      {purpose.items.map((item) => <article class="purpose__item"><h3>{item.title}</h3><p>{item.text}</p></article>)}
    </div>
    <p class="purpose__closing" data-animate>{purpose.closing}</p>
  </div>
</section>
