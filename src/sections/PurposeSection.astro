---
import type { DevInspectionBlock, SiteSettings } from "../domain/home-page";
import { getDevInspectorAttrs } from "../shared/utils/dev-inspection";

interface Props { purpose: SiteSettings["purpose"]; inspection: DevInspectionBlock; }
const { purpose, inspection } = Astro.props;
const devInspectorAttrs = getDevInspectorAttrs(inspection);
---
<section class="purpose section" id="purpose" {...devInspectorAttrs}>
  <div class="bd-container purpose__container">
    <h2 class="section-title" data-animate>{purpose.title}</h2>
    <p class="section-subtitle" data-animate>{purpose.subtitle}</p>
    <div class="purpose__grid" data-animate>
      {purpose.items.map((item) => <article class="purpose__item"><h3>{item.title}</h3><p>{item.text}</p></article>)}
    </div>
    <p class="purpose__closing" data-animate>{purpose.closing}</p>
  </div>
</section>
