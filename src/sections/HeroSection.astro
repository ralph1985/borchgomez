---
import SocialIcon from "../components/icons/SocialIcon.astro";
import type { SiteSettings } from "../domain/home-page";

interface Props { site: SiteSettings; }
const { site } = Astro.props;
const hero = site.hero;
const heroTitleWords = hero.title.split(/\s+/).filter(Boolean);
---
<section class="home" id="home">
        <svg class="home__roots" viewBox="0 0 720 520" aria-hidden="true" focusable="false">
          <g class="home__roots-main">
            <path d="M359 0c-12 86-12 151 0 229 11 72 5 139-41 215"></path>
            <path d="M356 150c-62 11-111 43-151 96-37 48-77 78-139 91"></path>
            <path d="M362 204c56 15 100 47 132 96 34 52 82 83 151 94"></path>
            <path d="M319 352c-53 18-90 52-113 102"></path>
            <path d="M396 344c42 21 72 56 90 103"></path>
          </g>
          <g class="home__roots-fine">
            <path d="M234 218c-39-1-75-17-108-48"></path>
            <path d="M204 247c-45 17-91 18-137 4"></path>
            <path d="M493 296c37-8 69-31 98-69"></path>
            <path d="M529 335c46 9 88 3 126-18"></path>
            <path d="M313 401c-33 4-61 18-84 43"></path>
            <path d="M409 398c29 6 54 24 74 53"></path>
          </g>
        </svg>
        <svg class="home__landscape" viewBox="0 0 1920 360" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
          <path
            class="home__field home__field--back"
            d="M0 233c142-42 260-55 403-29 112 20 194 65 319 56 133-10 229-74 374-68 122 5 218 55 344 34 168-28 298-74 480-41v175H0Z"
          ></path>
          <path
            class="home__field home__field--front"
            d="M0 289c176-67 311-76 484-37 111 25 205 74 332 69 143-5 245-76 392-62 87 8 154 35 232 17 171-40 306-46 480-6v90H0Z"
          ></path>
          <g class="home__furrows">
            <path d="M66 331c142-46 246-58 395-33"></path>
            <path d="M278 345c171-58 313-58 488 0"></path>
            <path d="M768 339c166-66 309-78 514-33"></path>
            <path d="M1033 352c176-66 335-68 502-6"></path>
            <path d="M1466 338c130-46 255-50 388-13"></path>
          </g>
          <g class="home__olive home__olive--left">
            <path class="home__olive-trunk" d="M182 255c7-28 11-58 7-91m0 43c-20-13-34-31-43-55m42 38c24-13 40-32 53-58"></path>
            <path
              class="home__olive-crown"
              d="M131 134c-22 31-8 74 30 80 15 28 59 27 75 1 34-3 55-36 40-68 12-35-21-68-56-55-23-31-72-20-79 18-22 3-39 12-10 24Z"
            ></path>
          </g>
          <g class="home__olive home__olive--center-left">
            <path class="home__olive-trunk" d="M637 255c7-28 11-58 7-91m0 43c-20-13-34-31-43-55m42 38c24-13 40-32 53-58"></path>
            <path
              class="home__olive-crown"
              d="M586 134c-22 31-8 74 30 80 15 28 59 27 75 1 34-3 55-36 40-68 12-35-21-68-56-55-23-31-72-20-79 18-22 3-39 12-10 24Z"
            ></path>
          </g>
          <g class="home__olive home__olive--center-right">
            <path class="home__olive-trunk" d="M938 262c-3-32 4-67 16-98m-8 43c-20-11-36-28-48-50m47 35c27-9 48-27 64-52"></path>
            <path
              class="home__olive-crown"
              d="M886 139c-27 27-18 72 17 83 11 31 56 36 77 13 35 3 61-27 51-62 17-32-10-71-47-64-18-35-69-32-83 4-23 0-42 7-15 26Z"
            ></path>
          </g>
          <g class="home__olive home__olive--right">
            <path class="home__olive-trunk" d="M1698 262c-3-32 4-67 16-98m-8 43c-20-11-36-28-48-50m47 35c27-9 48-27 64-52"></path>
            <path
              class="home__olive-crown"
              d="M1646 139c-27 27-18 72 17 83 11 31 56 36 77 13 35 3 61-27 51-62 17-32-10-71-47-64-18-35-69-32-83 4-23 0-42 7-15 26Z"
            ></path>
          </g>
        </svg>
  <div class="home__container bd-container bd-grid">
    <div class="home__data">
      <p class="home__greeting" data-animate>{hero.greeting}</p>
      <h1 class="home__title" data-animate>
        {heroTitleWords.map((word) => <span data-hero-word>{word}</span>)}
      </h1>
      <p class="home__career" data-animate>{hero.career}</p>
      <svg class="home__trace" viewBox="0 0 420 64" aria-hidden="true" focusable="false"><path d="M8 34c54-24 91-24 133-7 45 18 86 24 135 6 42-15 84-14 136 9M151 30c-4 12-9 21-18 29M201 38c-2 9-6 16-14 24M256 35c3 12 10 19 22 25"></path></svg>
      <p class="home__description" data-animate>{hero.description}</p>
      {hero.claims.map((claim) => <p class="home__claim" data-animate>{claim}</p>)}
      <div class="home__button" data-animate>
        {hero.actions.map((action) => <a class={action.className} href={action.href}>{action.label}</a>)}
      </div>
      <div class="home__social" data-animate>
        {site.socialLinks.map((link) => <a href={link.href} class="home__icon" target="_blank" rel="noopener noreferrer" aria-label={link.label}><SocialIcon type={link.type} /></a>)}
      </div>
    </div>
    <div class="home__img">
      <img src={hero.image.src} srcset={hero.image.srcset} sizes={hero.image.sizes} alt={hero.image.alt} width={hero.image.width} height={hero.image.height} decoding="async" class="home-image" />
    </div>
  </div>
</section>
