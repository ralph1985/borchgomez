---
import type { Project, SiteSettings } from "../domain/home-page";
interface Props { intro: SiteSettings["projectsIntro"]; projects: Project[]; }
const { intro, projects } = Astro.props;
---
<section class="portfolio section" id="portfolio" data-initial-visible={intro.initialVisible} data-load-step={intro.loadStep}>
  <h2 class="section-title" data-animate>{intro.title}</h2>
  <p class="section-subtitle" data-animate>{intro.subtitle}</p>
  <div class="bd-container">
    <div class="portfolio__filters" data-animate aria-label="Filtrar proyectos">
      {intro.filters.map((filter) => <button class:list={["portfolio__filter", { active: filter.value === "all" }]} data-filter={filter.value} type="button" aria-pressed={filter.value === "all" ? "true" : "false"}>{filter.label}</button>)}
    </div>
    <p class="visually-hidden" id="portfolio-status" aria-live="polite"></p>
    <div class="portfolio__grid" id="portfolio-grid" data-animate>
      {projects.map((project) => (
        <article class="portfolio__card" data-categories={(project.filters?.length ? project.filters : [project.filter]).filter(Boolean).join(" ")}>
          {project.image ? (
            <div class="portfolio__img"><img src={project.image.src} srcset={project.image.srcset} sizes={project.image.sizes} alt={project.image.alt} width={project.image.width} height={project.image.height} loading="lazy" decoding="async" /></div>
          ) : (
            <div class="portfolio__img portfolio__img--placeholder" role="img" aria-label="Imagen no disponible"><span>Imagen no disponible</span></div>
          )}
          <h3 class="portfolio__title">{project.title}</h3>
          <p class="portfolio__category">{project.subtitle || project.category}</p>
          <a class="portfolio__cta" href={project.link.href} target="_blank" rel="noopener">{project.link.label}</a>
        </article>
      ))}
    </div>
    <button class="portfolio__show-more" type="button" aria-controls="portfolio-grid" hidden>Mostrar más proyectos</button>
  </div>
</section>
