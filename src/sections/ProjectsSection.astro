---
import type { Project, SiteSettings } from "../domain/home-page";
interface Props { intro: SiteSettings["projectsIntro"]; projects: Project[]; }
const { intro, projects } = Astro.props;
---
<section class="portfolio section" id="portfolio">
  <h2 class="section-title" data-animate>{intro.title}</h2>
  <p class="section-subtitle" data-animate>{intro.subtitle}</p>
  <div class="bd-container">
    <div class="portfolio__filters" data-animate>
      {intro.filters.map((filter, index) => <button class:list={["portfolio__filter", { active: index === 0 }]} data-filter={filter.value} type="button">{filter.label}</button>)}
    </div>
    <div class="portfolio__grid" data-animate>
      {projects.map((project) => (
        <article class="portfolio__card" data-category={project.filter}>
          <div class="portfolio__img"><img src={project.image.src} srcset={project.image.srcset} sizes={project.image.sizes} alt={project.image.alt} width={project.image.width} height={project.image.height} loading="lazy" decoding="async" /></div>
          <h3 class="portfolio__title">{project.title}</h3>
          <p class="portfolio__category">{project.category}</p>
          <a class="portfolio__cta" href={project.link.href} target="_blank" rel="noopener noreferrer">{project.link.label}</a>
        </article>
      ))}
    </div>
    <button class="portfolio__show-more" type="button" hidden>Mostrar más proyectos</button>
  </div>
</section>
