---
import SocialIcon from "../icons/SocialIcon.astro";
import type { Service, SiteSettings } from "../../domain/home-page";

interface Props { site: SiteSettings; services: Service[]; }
const { site, services } = Astro.props;
const homePrefix = Astro.url.pathname === "/" ? "" : "/";
const toPageHref = (href: string) => href.startsWith("#") ? `${homePrefix}${href}` : href;
---
<header class="l-header" id="header">
  <nav class="nav bd-container" aria-label="Navegación principal">
    <a href={toPageHref("#home")} class="nav__logo nav__brand" aria-label={site.brand.label}>
      <img src={site.brand.logo.src} alt={site.brand.logo.alt} width={site.brand.logo.width} height={site.brand.logo.height} decoding="async" />
    </a>
    <div class="nav__menu" id="nav-menu">
      <ul class="nav__list">
        <li class="nav__item"><a href={toPageHref("#home")} class="nav__link">Inicio</a></li>
        <li class="nav__item"><a href={toPageHref("#purpose")} class="nav__link">Método</a></li>
        <li class="nav__item nav__item--services">
          <button class="nav__link nav__submenu-toggle" id="services-menu-toggle" type="button" aria-controls="services-submenu" aria-expanded="false">
            Servicios
            <span class="nav__submenu-icon" aria-hidden="true"></span>
          </button>
          <ul class="nav__submenu" id="services-submenu" aria-label="Servicios">
            {services.map((service) => (
              <li class={service.id === "service-local-seo" ? "nav__submenu-service" : undefined}>
                <a class="nav__submenu-link" href={toPageHref(`#${service.id}`)}>{service.title}</a>
                {service.id === "service-local-seo" && <ul class="nav__submenu-features">{site.serviceMenuFeatures.map((feature) => <li>{feature}</li>)}</ul>}
              </li>
            ))}
          </ul>
        </li>
        {site.nav.filter((item) => !["#home", "#purpose"].includes(item.href)).map((item) => (
          <li class="nav__item"><a href={toPageHref(item.href)} class={item.href === "#contact" ? "nav__link nav__link--contact" : "nav__link"}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div class="nav__actions">
      {site.socialLinks.map((link) => (
        <a href={link.href} class={link.type === "whatsapp" ? "nav__social-link nav__social-link--whatsapp" : "nav__social-link"} target="_blank" rel="noopener" aria-label={link.label}>
          <SocialIcon type={link.type} />
        </a>
      ))}
      <button class="nav__toggle" id="nav-toggle" type="button" aria-label="Abrir menú" aria-controls="nav-menu" aria-expanded="false">
        <svg class="icon-inline icon-inline--bars" viewBox="0 0 448 512" aria-hidden="true" focusable="false"><path d="M0 88C0 74.7 10.7 64 24 64h400c13.3 0 24 10.7 24 24s-10.7 24-24 24H24C10.7 112 0 101.3 0 88zm0 168c0-13.3 10.7-24 24-24h400c13.3 0 24 10.7 24 24s-10.7 24-24 24H24C10.7 280 0 269.3 0 256zm448 168c0 13.3-10.7 24-24 24H24c-13.3 0-24-10.7-24-24s10.7-24 24-24h400c13.3 0 24 10.7 24 24z"></path></svg>
      </button>
    </div>
  </nav>
</header>
