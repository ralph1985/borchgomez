---
import { getHomePageContent } from "../application/get-home-page-content";
import { contentRepository } from "../shared/config/content";
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutSection from "../sections/AboutSection.astro";
import ContactSection from "../sections/ContactSection.astro";
import HeroSection from "../sections/HeroSection.astro";
import PlansSection from "../sections/PlansSection.astro";
import ProjectsSection from "../sections/ProjectsSection.astro";
import PurposeSection from "../sections/PurposeSection.astro";
import ServicesSection from "../sections/ServicesSection.astro";

const { site, services, projects, plans, devInspection } = await getHomePageContent(contentRepository);
---
<BaseLayout site={site} services={services} devInspection={devInspection}>
  <HeroSection site={site} inspection={devInspection.hero} />
  <PurposeSection purpose={site.purpose} inspection={devInspection.purpose} />
  <ServicesSection intro={site.servicesIntro} services={services} inspection={devInspection.services} />
  <PlansSection plans={plans} />
  <ProjectsSection intro={site.projectsIntro} projects={projects} />
  <AboutSection about={site.about} />
  <ContactSection contact={site.contact} />
</BaseLayout>
